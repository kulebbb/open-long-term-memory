#!/bin/sh
# Rebuild INDEX.md and moc/*.md before committing memory changes.
# Enable once per clone: git config core.hooksPath .githooks
set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v python3 >/dev/null 2>&1; then
  echo "memory-index: python3 not found; skipping index generation (CI will verify)." >&2
  exit 0
fi

# The index is generated from the worktree. Refuse a commit that would publish
# an index describing memory files which are not part of that commit.
DIRS="profile people projects decisions journal open-loops"
DIRTY="$( {
  git diff --name-only -- $DIRS
  git ls-files --others --exclude-standard -- $DIRS
} | sed '/^$/d' \
  | awk -F/ '{ base=$NF; if (base ~ /\.md$/ && base !~ /^[._]/) print }' )"
if [ -n "$DIRTY" ]; then
  echo "memory-index: these memory files are not staged:" >&2
  echo "$DIRTY" | sed 's/^/  /' >&2
  echo "Stage them (or stash them) before committing." >&2
  exit 1
fi

if python3 scripts/build_memory_index.py; then
  git add INDEX.md moc
else
  echo "memory-index: generation or validation failed; commit aborted." >&2
  exit 1
fi
